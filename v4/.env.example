# v4 Pipeline — copy to .env and fill in values
# NEVER commit .env to version control

# ---------------------------------------------------------------------------
# Microsoft Entra app-only auth (ConfidentialClientApplication, cert-based)
# ---------------------------------------------------------------------------
MS_CLIENT_ID=<your-app-registration-client-id>
MS_TENANT_ID=<your-tenant-id-guid>

# Path to the private-key PEM file (generated alongside the cert you uploaded
# to the app registration in Azure Portal → Certificates & secrets).
# Generate:
#   openssl req -x509 -newkey rsa:2048 -keyout private.pem -out cert.pem -days 730 -nodes
#   openssl x509 -in cert.pem -fingerprint -sha1 -noout  ← gives the thumbprint
# Upload cert.pem to Azure Portal; keep private.pem here (gitignored).
MS_CERT_PATH=v4/private.pem

# SHA-1 thumbprint of the uploaded certificate (hex, no colons).
# Required when the .pem contains only the private key (no embedded cert chain).
# MS_CERT_THUMBPRINT=AABBCCDDEEFF...

# ---------------------------------------------------------------------------
# Shared mailbox (read-only — app has Mail.Read scoped via AppAccessPolicy)
# ---------------------------------------------------------------------------
# The UPN of the shared inbox this pipeline reads from (never writes to).
# IT prerequisite: New-ApplicationAccessPolicy scoping the app to this mailbox.
SHARED_MAILBOX_UPN=invoices@topcut.com.au

# Comma-separated attachment extensions to download (lowercase, with dot)
# ATTACHMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp,.xlsx,.xls,.csv

# ---------------------------------------------------------------------------
# Delta-poll scheduling
# ---------------------------------------------------------------------------
# How often to poll the inbox for new messages (minutes).
POLL_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Azure Document Intelligence (tier-3 table fallback — paid per page)
# ---------------------------------------------------------------------------
# From Azure Portal → Document Intelligence resource → Keys and Endpoint.
# Leave blank to skip Azure DI (tier-3 won't be attempted).
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=<your-azure-di-key>

# Minimum fraction of line items whose qty×price≈total before trusting
# the local table engine instead of escalating to Azure DI.
# MATH_GATE_MIN_RATIO=0.8
# MIN_LINE_ITEMS_FOR_GATE=1

# ---------------------------------------------------------------------------
# LLM escalation — Claude Haiku 4.5 (cheapest Claude; ~$0.003–0.008/doc)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Override model (e.g. claude-sonnet-4-6 for harder documents):
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# Slack/Teams/n8n webhook for auth alerts and pipeline errors.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
