# v4 Pipeline — copy to .env and fill in values
# NEVER commit .env to version control

# ---------------------------------------------------------------------------
# Microsoft Entra app-only auth (ConfidentialClientApplication, cert-based)
# ---------------------------------------------------------------------------
MS_CLIENT_ID=<your-app-registration-client-id>
MS_TENANT_ID=<your-tenant-id-guid>

# Path to the private-key PEM file (gitignored).
# Generate:
#   openssl req -x509 -newkey rsa:2048 -keyout private.pem -out cert.pem -days 730 -nodes
#   openssl x509 -in cert.pem -fingerprint -sha1 -noout   ← note the thumbprint
# Upload cert.pem to Azure Portal → App Registration → Certificates & secrets.
# Keep private.pem in this directory (it is gitignored).
# Recommended: restrict file permissions:  chmod 600 v4/private.pem
MS_CERT_PATH=v4/private.pem
# SHA-1 thumbprint (hex, no colons) — required if .pem is key-only (no cert chain).
# MS_CERT_THUMBPRINT=AABBCCDDEEFF...

# ---------------------------------------------------------------------------
# Shared mailbox (read-only — never written to)
# ---------------------------------------------------------------------------
# The UPN of the shared inbox this pipeline reads from.
# IT prerequisite: New-ApplicationAccessPolicy restricts the app to this mailbox.
SHARED_MAILBOX_UPN=invoices@topcut.com.au

# Comma-separated attachment extensions to download (lowercase, with dot).
# ATTACHMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp,.xlsx,.xls,.csv

# ---------------------------------------------------------------------------
# Sender allowlist — REQUIRED for production (see also v4/allowlist.json.example)
# ---------------------------------------------------------------------------
# Quick config: comma-separated domains or individual email addresses.
# All email from these senders is processed; everything else is logged and skipped.
# Leave blank to run in discovery mode (all senders allowed, with a warning).
ALLOWED_SENDER_DOMAINS=example-supplier.com.au,another-supplier.com
# ALLOWED_SENDER_EMAILS=individual@gmail.com

# Path to a JSON allowlist for more complex configs (optional).
# ALLOWLIST_PATH=v4/data/allowlist.json

# ---------------------------------------------------------------------------
# Attachment security
# ---------------------------------------------------------------------------
# Maximum attachment size in bytes before decoding (default: 25 MB).
# MAX_ATTACHMENT_BYTES=26214400

# ---------------------------------------------------------------------------
# Delta-poll scheduling
# ---------------------------------------------------------------------------
# How often to poll the shared inbox (minutes).
POLL_INTERVAL_MINUTES=5

# Set to 1 to process all existing messages on the very first run.
# Default is 0 (snapshot only — only new messages are processed after setup).
# FIRST_RUN_PROCESS=0

# ---------------------------------------------------------------------------
# Azure Document Intelligence (tier-3 table fallback — paid per page)
# ---------------------------------------------------------------------------
# From Azure Portal → Document Intelligence resource → Keys and Endpoint.
# Leave blank to skip Azure DI (tier-3 will not be attempted).
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=<your-azure-di-key>

# ---------------------------------------------------------------------------
# LLM escalation — Claude Haiku 4.5 (~$0.003–0.008 per extracted document)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Override model (e.g. claude-sonnet-4-6 for harder documents):
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Table math gate
# ---------------------------------------------------------------------------
# Fraction of qty×price≈total rows that must reconcile before trusting the
# local table engine.  Lower = more tolerant; higher = more Azure DI spend.
# MATH_GATE_MIN_RATIO=0.8
# MIN_LINE_ITEMS_FOR_GATE=1

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# Slack / Teams / n8n webhook for auth alerts and pipeline errors.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
